{
  "$schema": "./loop.config.schema.json",
  "requiredChecks": ["check"],
  "dangerousEdges": [
    ".github/workflows/**",
    "loop.config.json",
    "scripts/loop/**",
    "**/migrations/**"
  ],
  "branchPrefix": "claude/",
  "notify": {
    "channel": "none"
  },
  "mergeMode": "auto-merge-on-green",
  "scout": {
    "maxProposals": 5,
    "checks": {
      "emDash": true,
      "todoMarkers": true,
      "testsForSources": true,
      "oversizedAssets": true,
      "brokenInternalLinks": false,
      "missingMetaDescription": false
    }
  }
}
